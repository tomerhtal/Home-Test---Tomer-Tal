<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>PortfolioAssistant.Api</RootNamespace>
    <!-- כדי לבנות בלי AWS SDK (למשל בלי גישה ל-NuGet): dotnet build -p:IncludeBedrock=false -->
    <IncludeBedrock Condition="'$(IncludeBedrock)' == ''">true</IncludeBedrock>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IncludeBedrock)' == 'true'">
    <DefineConstants>$(DefineConstants);BEDROCK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PortfolioAssistant.Core\PortfolioAssistant.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeBedrock)' == 'true'">
    <ProjectReference Include="..\PortfolioAssistant.Bedrock\PortfolioAssistant.Bedrock.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\data\**\*" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
